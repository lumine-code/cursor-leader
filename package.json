{
  "name": "cursor-leader",
  "author": "lumine-code",
  "description": "Keyboard-driven multi-cursor creation and navigation commands.",
  "repository": "https://github.com/lumine-code/cursor-leader",
  "bugs": {
    "url": "https://github.com/lumine-code/cursor-leader/issues"
  },
  "keywords": [
    "multi-cursor",
    "multicursor",
    "selection",
    "navigation",
    "power-mode"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    }
  },
  "configSchema": {
    "cursorDecoration": {
      "title": "Decoration of the last cursor",
      "description": "The leader cursor is highlighted when there is more than one cursor.",
      "type": "boolean",
      "default": true
    },
    "decorationTime": {
      "title": "Time to disappear cursor decoration",
      "description": "Set the time in ms after which decoration disappears. If the timer is set to zero, the decoration is permanent.",
      "type": "integer",
      "minimum": 0,
      "default": 2000
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
