{
  "lumine-workspace": {
    "cmdorctrl-k c g": "cursor-leader:power-global"
  },
  // Deliberately includes mini editors: these commands act on whichever editor
  // owns the keystroke, including a picker or dialog query.
  "lumine-text-editor": {
    "cmdorctrl-k c e": "cursor-leader:power-editor",
    "ctrl-alt-pageup": "cursor-leader:previous",
    "ctrl-alt-pagedown": "cursor-leader:next",
    "cmdorctrl-k c up": "cursor-leader:move-up",
    "cmdorctrl-k c down": "cursor-leader:move-down",
    "cmdorctrl-k c left": "cursor-leader:move-left",
    "cmdorctrl-k c right": "cursor-leader:move-right"
  },
  "lumine-text-editor:not([mini])": {
    "ctrl-alt-enter": "cursor-leader:toggle"
  }
}
